VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Monta os links mágicos do módulo CIPA e o QR Code do cartaz de mural.
# Em produção precisa ser o domínio final antes de imprimir qualquer cartaz.
VITE_APP_URL=http://localhost:5173

# Envio do código de verificação (OTP) por e-mail na Porta B da votação
# (api/cipa/otp.ts). Crie uma conta em https://resend.com, verifique um
# domínio de envio e gere a chave em Dashboard > API Keys. Sem essa chave
# configurada, o código é só logado no servidor (nunca enviado) e todo
# mundo cai na quarentena de sempre — nada quebra, só não acelera.
RESEND_API_KEY=
OTP_EMAIL_REMETENTE="PrevSafe <votacao@seu-dominio.com.br>"

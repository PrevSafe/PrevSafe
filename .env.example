# ---------------------------------------------------------------------------
# PrevSafe SST - variaveis de ambiente
# Copie para .env.local no desenvolvimento e cadastre as mesmas chaves no
# painel do provedor de hospedagem para producao.
# ---------------------------------------------------------------------------

# Banco de dados e autenticacao (Supabase).
# Projeto: PrevSafe (ref dijwqveojqnazphzifhg, regiao sa-east-1 / Sao Paulo).
# As duas primeiras vao para o navegador; a terceira NUNCA - ela ignora a RLS
# e so e usada nas rotas de API do servidor.
NEXT_PUBLIC_SUPABASE_URL="https://dijwqveojqnazphzifhg.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# URL publica da aplicacao, sem barra no final. Ex.: https://app.suaempresa.com.br
# Entra no QR Code de validacao dos documentos assinados e nos links de convite.
# No navegador a origem real da pagina prevalece; esta variavel cobre a
# renderizacao no servidor. Precisa bater com o dominio de producao, senao o QR
# impresso num PGR assinado aponta para o lugar errado.
NEXT_PUBLIC_APP_URL="https://prevsafe.com.br"

# Copiloto de IA (Google Gemini). Opcional: sem a chave, as telas de IA ficam
# indisponiveis e o resto do sistema funciona normalmente.
GEMINI_API_KEY=""
